{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "crud-builder": {
      "projectType": "library",
      "root": "projects/crud-builder",
      "sourceRoot": "projects/crud-builder/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/crud-builder/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/crud-builder/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/crud-builder/tsconfig.spec.json",
            "setupFiles": ["projects/crud-builder/src/test-setup.ts"]
          }
        }
      }
    },
    "crud-builder-demo": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/crud-builder-demo",
      "sourceRoot": "projects/crud-builder-demo/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/crud-builder-demo/src/main.ts",
            "tsConfig": "projects/crud-builder-demo/tsconfig.app.json",
            "polyfills": ["@angular/localize/init"],
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/crud-builder-demo/public"
              }
            ],
            "styles": [
              "projects/crud-builder/src/styles/edition-dialog.scss",
              "projects/crud-builder-demo/src/styles.scss",
              "node_modules/primeicons/primeicons.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "crud-builder-demo:build:production"
            },
            "development": {
              "buildTarget": "crud-builder-demo:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
